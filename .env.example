# NexSpaces API Configuration
# Copy this file to .env and configure your environment variables

# ================================
# SERVER CONFIGURATION
# ================================
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# Server timeouts
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s

# ================================
# DATABASE CONFIGURATION
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=nexspaces_dev
DB_SSLMODE=disable

# Connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30  # minutes

# ================================
# REDIS CONFIGURATION
# ================================
# Either use REDIS_URL (recommended) or individual settings
REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0

# ================================
# AUTHENTICATION
# ================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h  # 7 days
INVITE_TOKEN_EXPIRY=72h    # 3 days
PASSWORD_RESET_EXPIRY=1h

# ================================
# SECURITY CONFIGURATION
# ================================
ALLOWED_ORIGINS=http://localhost:3000,https://app.nexspaces.com
ALLOW_CREDENTIALS=true
MAX_REQUEST_SIZE=10MB
ENABLE_CSP=true
ENABLE_HSTS=false  # Set to true in production with HTTPS
TRUSTED_PROXIES=127.0.0.1,::1

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1  # minutes

# ================================
# EXTERNAL SERVICES (TODO)
# ================================
# Stripe for billing
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email service (SendGrid, AWS SES, etc.)
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@nexspaces.com

# File storage (AWS S3, Cloudflare R2, etc.)
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=nexspaces-templates
# STORAGE_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ================================
# OBSERVABILITY (TODO)
# ================================
# Logging level
LOG_LEVEL=info

# Monitoring (Sentry, etc.)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Metrics (Prometheus, etc.)
# METRICS_ENABLED=false
# METRICS_PORT=9090

# ================================
# DEVELOPMENT SETTINGS
# ================================
# Enable debug mode (more verbose logging, etc.)
DEBUG=true

# Disable authentication for development
# DEV_DISABLE_AUTH=false

# Enable API documentation
# ENABLE_SWAGGER=true

# ================================
# PRODUCTION NOTES
# ================================
# For production deployment:
# 1. Change JWT_SECRET to a strong random value
# 2. Set ENVIRONMENT=production
# 3. Enable HSTS: ENABLE_HSTS=true
# 4. Configure proper ALLOWED_ORIGINS
# 5. Set up SSL/TLS certificates
# 6. Configure real Redis instance
# 7. Use managed PostgreSQL instance
# 8. Set up proper monitoring and logging
# 9. Configure backup strategies
# 10. Set up CI/CD pipelines