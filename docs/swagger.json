{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "This is a production-ready multi-tenant SaaS backend built with modern Clean Architecture + DDD patterns.",
        "title": "NexSpaces API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "https://www.nexspaces.com/support",
